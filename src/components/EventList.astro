---
// 일정 줄 목록 (날짜 머리 없이). 날짜별로 묶을 때는 DayList.astro
import type { EventRow } from '../lib/view/calendar';
interface Props { rows: EventRow[]; empty: string }
const { rows, empty } = Astro.props;
---
{rows.length === 0 ? <p class="empty">{empty}</p> : (
  <ul class="rows">
    {rows.map((r) => (
      <li class="ev" data-group={r.group}>
        <span class="badge">{r.kindLabel}</span>
        <span class="ev-main">
          {r.href ? <a class="ev-title" href={r.href}>{r.title}</a> : <span class="ev-title">{r.title}</span>}
          <span class="ev-meta tabular">{r.dateText}</span>
        </span>
      </li>
    ))}
  </ul>
)}
