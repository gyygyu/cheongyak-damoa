---
// form 태그와 name 속성을 쓰지 않는다 — 제출·주소 쿼리로 값이 나갈 길을 없앤다 (tests/eligibility-no-leak.test.ts)
// 선택 칸의 첫 값은 모두 ''(모름): 고르지 않은 칸은 '확인 필요'로 판정한다 (tests/eligibility-review-fixes.test.ts)
import {
  MAX_CHILDREN, SUPPLY_OPTIONS, YES_NO_OPTIONS, HOME_OWNER_OPTIONS, MARRIED_OPTIONS, PARENT_CARE_OPTIONS,
  CHILD_COUNT_OPTIONS, CHILD_KIND_OPTIONS, type FormValues, type Options,
} from '../lib/view/eligibility-form';
import { DISCLAIMER } from '../lib/eligibility';
interface Props { prefill: FormValues; title: string | null }
const { prefill, title } = Astro.props;
const val = (k: string) => prefill[k] ?? '';

/** 칸 하나. when = 'field:value' 이면 그 칸이 그 값일 때만 보인다, unless 는 그 값일 때 숨긴다 */
interface Field {
  key: string; label: string; help?: string; when?: string; unless?: string;
  kind: 'select' | 'date' | 'number'; options?: Options; inputmode?: 'numeric' | 'decimal'; unit?: string;
}
const steps: { title: string; fields: Field[]; children?: boolean }[] = [
  { title: '공고 정보', fields: [
    { key: 'supplyKind', label: '공급 구분', kind: 'select', options: SUPPLY_OPTIONS, help: '공고문에 적힌 국민주택·민영주택' },
    { key: 'areaExcl', label: '전용면적', kind: 'number', inputmode: 'decimal', unit: '㎡', help: '예: 84.97' },
    { key: 'noticeDate', label: '입주자모집공고일', kind: 'date' },
    { key: 'publicBuilder', label: '공공 사업주체 공급', kind: 'select', options: YES_NO_OPTIONS, help: '국가·지자체·LH·지방공사가 공급하면 예' },
  ] },
  { title: '세대·주택', fields: [
    { key: 'homeOwner', label: '지금 세대의 주택 소유', kind: 'select', options: HOME_OWNER_OPTIONS },
    { key: 'everOwned', label: '과거 주택 소유 이력', kind: 'select', options: YES_NO_OPTIONS, help: '세대 구성원 모두 기준' },
    { key: 'householdHead', label: '세대주인가', kind: 'select', options: YES_NO_OPTIONS },
    { key: 'singleHousehold', label: '단독세대주·세대원 아닌 동거인', kind: 'select', options: YES_NO_OPTIONS },
    { key: 'householdSize', label: '세대 구성원 수', kind: 'number', inputmode: 'numeric', unit: '명', help: '태아 포함' },
  ] },
  { title: '혼인·자녀', children: true, fields: [
    { key: 'married', label: '혼인 여부', kind: 'select', options: MARRIED_OPTIONS },
    { key: 'marriageDate', label: '혼인신고일', kind: 'date', when: 'married:true' },
    { key: 'childCount', label: '자녀 수', kind: 'select', options: CHILD_COUNT_OPTIONS, help: '태아·입양 자녀 포함' },
  ] },
  { title: '소득·청약통장', fields: [
    { key: 'monthlyIncome', label: '세대 월평균 소득', kind: 'number', inputmode: 'numeric', unit: '만원' },
    { key: 'dualIncome', label: '배우자도 소득이 있다', kind: 'select', options: YES_NO_OPTIONS, unless: 'married:false' },
    { key: 'incomeTaxYears', label: '소득세 납부 연수', kind: 'number', inputmode: 'numeric', unit: '년', help: '근로자·자영업자로 낸 기간' },
    { key: 'savingsMonths', label: '청약통장 가입 기간', kind: 'number', inputmode: 'numeric', unit: '개월' },
    { key: 'savingsPayments', label: '납입 회차', kind: 'number', inputmode: 'numeric', unit: '회' },
    { key: 'savingsTotal', label: '납입 총액', kind: 'number', inputmode: 'numeric', unit: '만원', help: '선납금 포함' },
    { key: 'priorSpecial', label: '본인·배우자 특별공급 당첨 이력', kind: 'select', options: YES_NO_OPTIONS },
  ] },
  { title: '노부모 부양', fields: [
    { key: 'parentCare', label: '65세 이상 직계존속을 부양하나', kind: 'select', options: PARENT_CARE_OPTIONS, help: '배우자의 직계존속 포함' },
    { key: 'parentBirth', label: '직계존속 생년월일', kind: 'date', when: 'parentCare:true' },
    { key: 'parentSince', label: '같은 등본에 오른 날', kind: 'date', when: 'parentCare:true' },
    { key: 'parentSpouseHomeless', label: '그 배우자도 무주택', kind: 'select', options: YES_NO_OPTIONS, when: 'parentCare:true', help: '배우자가 없으면 예' },
  ] },
];
const idOf = (key: string) => `elig-${key.replace(/\./g, '-')}`;
---
<section class="elig" data-elig>
  {title && <p class="hint">{title} 공고값을 채워 두었습니다. 다른 공고로 보려면 고치세요.</p>}
  <p class="elig-privacy">입력값은 이 기기 안에서만 계산하고 어디에도 보내거나 저장하지 않습니다. 모르는 칸은 비워 두거나 '모름'을 고르면 '확인 필요'로 나옵니다.</p>

  {steps.map((s, si) => (
    <fieldset class="step">
      <legend><span class="step-no">{si + 1}</span>{s.title}</legend>
      <div class="grid">
        {s.fields.map((f) => (
          <div class="f" data-when={f.when} data-unless={f.unless} hidden={f.when !== undefined}>
            <label for={idOf(f.key)}>{f.label}</label>
            {f.kind === 'select' ? (
              <select id={idOf(f.key)} data-field={f.key} aria-describedby={f.help ? `${idOf(f.key)}-help` : undefined}>
                {f.options!.map(([v, t]) => <option value={v} selected={val(f.key) === v}>{t}</option>)}
              </select>
            ) : f.kind === 'date' ? (
              <input id={idOf(f.key)} data-field={f.key} type="date" value={val(f.key)} aria-describedby={f.help ? `${idOf(f.key)}-help` : undefined} />
            ) : (
              <div class="f-box">
                <input id={idOf(f.key)} data-field={f.key} type="text" inputmode={f.inputmode} autocomplete="off" spellcheck="false"
                  value={val(f.key)} aria-describedby={[f.help ? `${idOf(f.key)}-help` : '', f.unit ? `${idOf(f.key)}-unit` : ''].filter(Boolean).join(' ') || undefined} />
                {f.unit && <span class="f-unit" id={`${idOf(f.key)}-unit`}>{f.unit}</span>}
              </div>
            )}
            {f.help && <p class="f-help" id={`${idOf(f.key)}-help`}>{f.help}</p>}
          </div>
        ))}
        {s.children && Array.from({ length: MAX_CHILDREN }, (_, i) => (
          <div class="child" data-child={i} hidden>
            <p class="child-title">{i + 1}째 자녀</p>
            <div class="f">
              <label for={idOf(`children.${i}.kind`)}>구분</label>
              <select id={idOf(`children.${i}.kind`)} data-field={`children.${i}.kind`}>{CHILD_KIND_OPTIONS.map(([v, t]) => <option value={v}>{t}</option>)}</select>
            </div>
            <div class="f">
              <label for={idOf(`children.${i}.birth`)}>생년월일</label>
              <input id={idOf(`children.${i}.birth`)} data-field={`children.${i}.birth`} type="date" aria-describedby={`${idOf(`children.${i}.birth`)}-help`} />
              <p class="f-help" id={`${idOf(`children.${i}.birth`)}-help`}>태아는 출산 예정일</p>
            </div>
          </div>
        ))}
      </div>
    </fieldset>
  ))}

  <div class="elig-actions">
    <button type="button" class="btn" data-judge>판정하기</button>
  </div>
  <div class="elig-errors" data-errors role="alert"></div>
  <div class="elig-result" data-result aria-live="polite"></div>
  <p class="page-notice elig-disclaimer">{DISCLAIMER}</p>
</section>

<style>
  /* 판정 폼 — 전역 .elig·fieldset·select 규칙보다 앞서도록 범위 지정 스타일로 둔다(DESIGN.md 토큰, 없으면 기본값) */
  .elig { display: grid; gap: 24px; max-width: 880px; }
  .elig-privacy { margin: 0; font-size: 13px; line-height: 1.5; color: var(--ink-2, #525252); }

  .step { min-width: 0; margin: 0; padding: 20px 0 0; border: 0; border-top: 1px solid var(--line, #e9e9eb); }
  .step legend { float: left; width: 100%; display: flex; align-items: center; gap: 8px; margin: 0 0 16px; padding: 0; font-size: 17px; font-weight: 700; color: var(--ink, #171717); }
  .step-no { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: var(--brand-weak, #e8eef8); color: var(--brand-text, #1b4080); font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .grid { clear: both; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 248px), 1fr)); gap: 16px 20px; }

  .f { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .f[hidden], .child[hidden] { display: none; }
  .f label { font-size: 14px; font-weight: 600; line-height: 1.4; color: var(--ink, #171717); word-break: keep-all; }
  .f select, .f input {
    box-sizing: border-box; width: 100%; max-width: none; height: 44px; min-height: 44px; margin: 0; padding: 0 12px;
    font: inherit; font-size: 15px; color: var(--ink, #171717); background: #fff;
    border: 1px solid var(--line-strong, #dcdcdf); border-radius: 8px;
  }
  .f input[type='date'] { padding: 0 10px; }
  .f select:hover, .f input:hover { border-color: var(--muted, #6b6b6b); }
  .f select:focus-visible, .f input:focus-visible { outline: 2px solid var(--brand, #2557a7); outline-offset: 2px; border-color: var(--brand, #2557a7); }
  .f [aria-invalid='true'] { border-color: var(--warn, #c23c37); }
  .f-box { position: relative; }
  .f-box input { padding-right: 52px; font-variant-numeric: tabular-nums; }
  .f-unit { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); font-size: 14px; color: var(--ink-2, #525252); pointer-events: none; }
  .f-help { margin: 0; font-size: 13px; line-height: 1.45; color: var(--ink-2, #525252); }
  .f :global(.f-error) { margin: 0; font-size: 13px; font-weight: 600; line-height: 1.45; color: var(--warn, #c23c37); }

  .child { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 248px), 1fr)); gap: 12px 20px; padding: 12px 16px 16px; background: var(--surface, #f4f4f5); border-radius: 8px; }
  .child-title { grid-column: 1 / -1; margin: 0; font-size: 14px; font-weight: 700; }

  .elig-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .elig-actions .btn { min-width: 160px; min-height: 48px; border-radius: 8px; }
  .elig-errors:empty, .elig-result:empty { display: none; }
  .elig-errors :global(p) { margin: 0; padding: 10px 12px; border-radius: 8px; background: var(--warn-weak, #fbeeed); color: var(--warn, #c23c37); font-size: 14px; font-weight: 600; }
  .elig-disclaimer { margin: 0; font-size: 13px; color: var(--ink-2, #525252); }

  /* 결과 — 판정 스크립트가 그린다 */
  .elig-result :global(.r-title) { margin: 0 0 8px; font-size: 17px; font-weight: 700; }
  .elig-result :global(.r-title:focus:not(:focus-visible)) { outline: none; }
  .elig-result :global(.r-title:focus-visible) { outline: 2px solid var(--brand, #2557a7); outline-offset: 2px; border-radius: 4px; }
  .elig-result :global(.r-summary) { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; padding: 0; list-style: none; }
  .elig-result :global(.r-count) { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 12px; border-radius: 6px; font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .elig-result :global(.r-count b) { font-size: 16px; }
  .elig-result :global(.is-ok) { background: var(--done-weak, #eef4eb); color: var(--done, #4f7f47); }
  .elig-result :global(.is-no) { background: var(--warn-weak, #fbeeed); color: var(--warn, #c23c37); }
  .elig-result :global(.is-check) { background: var(--amber-weak, #fbf2e1); color: var(--amber, #8a5509); }

  .elig-result :global(.r-list) { border-top: 1px solid var(--line, #e9e9eb); }
  .elig-result :global(.r-type) { border-bottom: 1px solid var(--line, #e9e9eb); }
  .elig-result :global(.r-type > summary) { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; min-height: 52px; padding: 8px 4px; cursor: pointer; list-style: none; }
  .elig-result :global(.r-type > summary::-webkit-details-marker) { display: none; }
  .elig-result :global(.r-type > summary::before) { content: ''; flex: none; width: 7px; height: 7px; margin: 0 4px 0 2px; border-right: 1.75px solid var(--ink-2, #525252); border-bottom: 1.75px solid var(--ink-2, #525252); transform: rotate(-45deg); transition: transform 0.15s; }
  .elig-result :global(.r-type[open] > summary::before) { transform: rotate(45deg); }
  .elig-result :global(.r-type > summary:focus-visible) { outline: 2px solid var(--brand, #2557a7); outline-offset: 2px; border-radius: 4px; }
  .elig-result :global(.r-name) { font-size: 15px; font-weight: 700; }
  .elig-result :global(.r-badge) { padding: 2px 8px; border-radius: 6px; font-size: 13px; font-weight: 700; }
  .elig-result :global(.r-rank) { font-size: 13px; font-weight: 600; color: var(--ink-2, #525252); }
  .elig-result :global(.r-article) { margin-left: auto; font-size: 13px; color: var(--muted, #6b6b6b); }
  .elig-result :global(.r-body) { padding: 0 4px 16px 24px; }
  .elig-result :global(.r-next) { margin: 0 0 12px; padding: 10px 12px; border-radius: 8px; background: var(--surface, #f4f4f5); font-size: 14px; line-height: 1.5; }
  .elig-result :global(.r-next b) { margin-right: 6px; }
  .elig-result :global(.r-checks) { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .elig-result :global(.r-check) { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 2px 10px; font-size: 14px; line-height: 1.5; }
  .elig-result :global(.r-mark) { font-size: 13px; font-weight: 700; }
  .elig-result :global(.r-mark.is-ok), .elig-result :global(.r-mark.is-no), .elig-result :global(.r-mark.is-check) { background: none; }
  .elig-result :global(.r-check-article) { margin-left: 6px; font-size: 13px; color: var(--muted, #6b6b6b); }
  .elig-result :global(.r-check-note) { grid-column: 2; margin: 0; font-size: 13px; color: var(--ink-2, #525252); }
</style>
