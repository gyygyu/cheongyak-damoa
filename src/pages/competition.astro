---
import Base from '../layouts/Base.astro';
import { KV_KEYS } from '../lib/kv-keys';
import { getJson } from '../server/kv';
import { setPublicCache } from '../server/cache';
import { competitionRows } from '../lib/view/region';
import { truncatedNotice } from '../lib/view/truncated';
import type { CompetitionBundle } from '../lib/view/bundle-types';

const bundle = await getJson<CompetitionBundle>(KV_KEYS.competition);
const rows = competitionRows(bundle);
const truncated = truncatedNotice(bundle);
setPublicCache(Astro.response.headers);
---
<Base title="청약 경쟁률 모음" description="최근 아파트 청약 단지별 최고 경쟁률과 접수 건수" sources={['competition', 'applyhome']}>
  <h1>청약 경쟁률 모음</h1>
  {truncated && <p class="hint">{truncated}</p>}
  {rows.length === 0 ? <p class="empty">경쟁률 자료가 아직 없습니다.</p> : (
    <div class="table-wrap"><table class="data-table data-table--stack">
      <thead><tr><th>단지</th><th>지역</th><th>모집공고</th><th class="num">최고 경쟁률</th><th class="num">접수</th><th class="num">공급</th></tr></thead>
      {/* 휴대폰(760px 이하)에서는 행마다 단지명 → 최고 경쟁률 크게 → 나머지 'data-label 값' 줄로 쌓는다 (global.css .data-table--stack) */}
      <tbody>{rows.map((r) => (
        <tr>
          <td class="cell-title" data-label="단지"><a href={r.href}>{r.name}</a></td>
          <td data-label="지역">{r.place}</td>
          <td class="num" data-label="모집공고">{r.noticeDate}</td>
          <td class="num cell-key" data-label="최고 경쟁률">{r.rate}{r.short && <span class="badge badge--short">{r.short}</span>}</td>
          <td class="num" data-label="접수">{r.applicants}</td>
          <td class="num" data-label="공급">{r.supply}</td>
        </tr>
      ))}</tbody>
    </table></div>
  )}
  {rows.length > 0 && (
    <ul class="notes">
      <li>최고 경쟁률: 주택형·순위·거주지역(해당·기타)별 경쟁률 가운데 가장 높은 값입니다.</li>
      <li>접수: 1·2순위 일반공급 접수 건수를 모두 더한 값입니다. 특별공급은 넣지 않았습니다.</li>
      <li>공급: 주택형별 일반공급 세대수의 합입니다.</li>
      <li>미달: 1·2순위 접수를 다 더해도 공급 세대수보다 적은 주택형이 있다는 뜻입니다. 모든 주택형이 그렇다면 '미달', 일부면 '일부 미달'입니다.</li>
    </ul>
  )}
</Base>

<style>
  .badge--short { margin: 0 0 0 8px; background: var(--warn-weak); color: var(--warn); }
  .data-table td .badge--short:first-child { margin-left: 0; }
  .notes { margin: 12px 0 0; padding: 0; list-style: none; font-size: 13px; color: var(--muted); }
  .notes li { margin: 4px 0; }
</style>
