{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cheongyak-damoa",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 로컬 개발용 자리값 — 배포 전에 실제 ID로 바꾼다 (docs/deploy.md)
  "d1_databases": [
    { "binding": "DB", "database_name": "cheongyak-damoa", "database_id": "5c7a1326-00f4-4c75-8691-ae3fdd8321e1", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "KV", "id": "298557e5e0a54ce4949ef6545a198a8b" }
  ],
  "vars": { "SITE_URL": "https://cheongyak-damoa.heegyu010.workers.dev" }
}
